# Copy to .env.local for local dev. On Vercel, set these in Project Settings > Environment Variables.

# Public site settings
NEXT_PUBLIC_SITE_URL=https://www.tampawebsiteservices.com
NEXT_PUBLIC_DEMO_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# AI concierge (Anthropic). Without a key, the chat answers with a friendly fallback and the booking link.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Instant AI Audit. Works without a key at low volume; add one for reliability.
PAGESPEED_API_KEY=

# Supabase (leads, audits, chats). Server-side only. Never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: email Manny when a lead comes in (Resend)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=
